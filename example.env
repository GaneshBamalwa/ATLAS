# ==========================================
# UNIFIED ENVIRONMENT CONFIGURATION - EXAMPLE
# ==========================================

# --- Groq / LLM (Fallback) ---
GROQ_API_KEY=your_groq_api_key_here

# --- OpenRouter / LLM (Active) ---
OPENROUTER_API_KEY=your_openrouter_api_key_here
LLM_MODEL=meta-llama/llama-3.3-70b-instruct
LLM_BASE_URL=https://openrouter.ai/api/v1

# --- Central Orchestrator (Port 9000) ---
ORCHESTRATOR_PORT=9000
ORCHESTRATOR_HOST=0.0.0.0
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8000

# --- Google MCP Service (Port 8000) ---
PORT=8000
GMAIL_MCP_BASE_URL=http://localhost:8000
GMAIL_MCP_API_PREFIX=/api
GOOGLE_CLIENT_SECRETS_JSON=credentials.json
REDIRECT_URI=http://localhost:8000/auth/callback
FRONTEND_URL=http://localhost:3000

# --- Timeouts & Retries ---
MCP_CALL_TIMEOUT=90
LLM_CALL_TIMEOUT=120
MAX_RETRIES=3
RETRY_BACKOFF=1.5

# --- Feature Flags ---
ENABLE_EMAIL_INTELLIGENCE=true
ENABLE_SEMANTIC_SEARCH=true
MAX_WORKERS=5
