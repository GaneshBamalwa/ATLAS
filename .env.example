# ============================================================================
# ATLAS Development Environment Configuration
# Copy this file to .env and fill in your specific values for local development
# ============================================================================

# Environment
ENV=dev
LOG_LEVEL=INFO
DEBUG=false

# ============================================================================
# LLM CONFIGURATION
# ============================================================================

# LLM Configuration (cloud-first)
# Groq: fast routing / intent classification
LLM_ROUTING_MODEL=llama-3.3-70b-versatile
LLM_ROUTING_API_KEY=your_groq_api_key_here

# OpenRouter: alternate routing endpoint
LLM_OPENROUTER_API_KEY=your_openrouter_api_key_here
LLM_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Mistral: reasoning / fallback
LLM_REASONING_MODEL=mistral-large-latest
LLM_MISTRAL_API_KEY=your_mistral_api_key_here

# Embeddings provider for memory
LLM_EMBEDDING_PROVIDER=openai

# ============================================================================
# SERVICE PORTS & URLS
# ============================================================================

# Orchestrator (Central reasoning engine)
ORCHESTRATOR_HOST=0.0.0.0
ORCHESTRATOR_PORT=9000
ORCHESTRATOR_URL=http://localhost:9000

# Google MCP Service (Gmail, Drive, Calendar integration)
GOOGLE_MCP_HOST=0.0.0.0
GOOGLE_MCP_PORT=8000
GOOGLE_MCP_URL=http://localhost:8000
GOOGLE_MCP_API_PREFIX=/api

# Memory Service (Semantic persistence)
MEMORY_HOST=0.0.0.0
MEMORY_PORT=8002
MEMORY_URL=http://localhost:8002

# Sentinel Service (Proactive monitoring daemon)
SENTINEL_HOST=0.0.0.0
SENTINEL_PORT=9001
SENTINEL_URL=http://localhost:9001

# ============================================================================
# GOOGLE WORKSPACE OAUTH
# ============================================================================

GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/callback
GOOGLE_SCOPES=https://www.googleapis.com/auth/gmail.modify,https://www.googleapis.com/auth/drive.readonly,https://www.googleapis.com/auth/calendar.readonly

# Path to Google credentials JSON (for service account authentication)
GOOGLE_CLIENT_SECRETS_JSON=./services/google-mcp/credentials.json

# ============================================================================
# DATABASE & STORAGE
# ============================================================================

# Redis (Session store and job queue)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ChromaDB (Vector embedding store)
CHROMADB_HOST=localhost
CHROMADB_PORT=8000
CHROMADB_COLLECTION_NAME=atlas_facts

# ============================================================================
# WEB CONSOLE
# ============================================================================

# Frontend development port
WEB_CONSOLE_PORT=5173
WEB_CONSOLE_DEV_PORT=5173
WEB_CONSOLE_PROD_PORT=3000

# CORS allowed origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8000

# ============================================================================
# HTTP CLIENT CONFIGURATION
# ============================================================================

# Timeouts (in seconds)
MCP_CALL_TIMEOUT=90
LLM_CALL_TIMEOUT=60
TOOL_EXECUTION_TIMEOUT=30

# Retry strategy
MAX_RETRIES=3
RETRY_BACKOFF=1.5

# ============================================================================
# APPLICATION CONFIGURATION
# ============================================================================

# Orchestrator-specific settings
DEFAULT_EXECUTION_ENGINE=react
MAX_REACT_ITERATIONS=10
REACT_ITERATION_TIMEOUT=30
MAX_PARALLEL_TOOLS=5

# Memory service settings
MEMORY_EMBEDDING_MODEL=text-embedding-3-small
MEMORY_FACT_TTL_DAYS=30
MEMORY_CACHE_SIZE=1000

# Sentinel daemon settings
SENTINEL_CHECK_INTERVAL=300
SENTINEL_BATCH_SIZE=10
SENTINEL_MAX_SUGGESTIONS=5

# ============================================================================
# OBSERVABILITY & MONITORING
# ============================================================================

# Tracing
TRACE_ENABLED=true
TRACE_SAMPLE_RATE=1.0

# Metrics
METRICS_ENABLED=true
METRICS_PORT=9090

# ============================================================================
# SECURITY
# ============================================================================

# JWT token settings (if applicable)
JWT_SECRET_KEY=your_super_secret_jwt_key_change_in_production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# API Keys (if using API key auth)
API_KEYS=dev_key_1,dev_key_2

# ============================================================================
# DEVELOPMENT UTILITIES
# ============================================================================

# Enable mock services for local testing
USE_MOCK_GOOGLE_MCP=false
USE_MOCK_MEMORY_SERVICE=false

# Enable detailed logging
VERBOSE_LOGGING=false

# Enable hot reload for services
AUTO_RELOAD=true

# ============================================================================
# NOTES
# ============================================================================
# - For Docker Compose: Use docker-compose.yml environment section
# - For Kubernetes: Use ConfigMaps and Secrets
# - Keep sensitive values (API keys, passwords) in .env.local (git-ignored)
# - For production: Use environment variables from secrets management service
# - Update Ollama model name if using different model: e.g., qwen:7b, mistral:7b
